APP_ENV=development
APP_DEBUG=true

# ==============================================================
# Database (O2Switch MySQL)
# ==============================================================
DB_HOST=mysql.o2switch.net
DB_PORT=3306
DB_USER=sc9bewu6999_user
DB_PASSWORD=
DB_NAME=sc9bewu6999_stock

# ==============================================================
# JWT — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ==============================================================
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# ==============================================================
# Email SMTP O2Switch
# ==============================================================
# Coupe-circuit d'envoi. Mettre EMAIL_ENABLED=false en developpement : les
# identifiants ci-dessous sont ceux de la messagerie reelle de l'association, et
# tester le depot de notes de frais ecrirait a de vrais destinataires. Les
# courriels sont alors journalises (destinataires compris) sans etre envoyes.
EMAIL_ENABLED=true

# Serveur de messagerie O2Switch (cPanel > Comptes de messagerie).
# Port 465 = SSL/TLS implicite  -> SMTP_USE_SSL=true,  SMTP_USE_TLS=false
# Port 587 = STARTTLS           -> SMTP_USE_SSL=false, SMTP_USE_TLS=true
# Combiner 465 et STARTTLS fait echouer la connexion silencieusement.
SMTP_HOST=mail.lekouttab.fr
SMTP_PORT=465
SMTP_USER=no-reply@lekouttab.fr
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_FROM=no-reply@lekouttab.fr
EMAIL_FROM_NAME=Le Kouttab Stock

# Adresse du service comptable : destinataire des factures et tickets de caisse
# convertis en PDF. Plusieurs adresses possibles, separees par des virgules.
# Si vide, les envois restent en file d'attente et partiront des que l'adresse
# sera renseignee : rien n'est perdu.
COMPTA_EMAIL=comptabilite@lekouttab.fr

# Repertoire des PDF prets a l'envoi. Doit rester HORS de UPLOAD_DIR : le
# .htaccess laisse passer /backend/uploads/, et ces fichiers portent des noms
# previsibles ({Pole}_{Evenement}_{Date}.pdf).
OUTBOX_DIR=./outbox
# Poids cumule maximal des pieces jointes par courriel. Au-dela, l'envoi est
# decoupe en plusieurs messages plutot que de faire echouer le depot.
MAX_ATTACHMENT_TOTAL_MB=15

# ==============================================================
# CORS / URLs
# ==============================================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173,https://stock.lekouttab.fr

# ==============================================================
# Uploads
# ==============================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=50

# ==============================================================
# Rate limit
# ==============================================================
RATE_LIMIT_ENABLED=true

# ==============================================================
# Chiffrement du RIB au repos (AES-256-GCM)
# ==============================================================
# Le RIB est le champ le plus sensible de la base. Les permissions de role ne
# protegent rien de ce qui contourne l'application : export, sauvegarde egaree,
# acces MySQL direct. Il est donc chiffre en colonne.
#
# Generer la cle :
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# ATTENTION : perdre cette cle rend les RIB deja enregistres DEFINITIVEMENT
# illisibles. Elle se conserve avec le .env, hors du depot. En production, son
# absence empeche le demarrage — un RIB ecrit en clair sans que personne ne
# s'en apercoive serait pire qu'un refus de demarrage.
RIB_ENCRYPTION_KEY=

# ==============================================================
# Sauvegarde des fichiers deposes (service `backup` du compose)
# ==============================================================
# Les justificatifs ne sont PAS en base : la table ne garde qu'un chemin, les
# fichiers vivent dans les volumes Docker du VPS. La sauvegarde O2Switch de
# MySQL ne les couvre donc pas, et sans ce service la perte du VPS emportait
# toutes les pieces comptables.
#
# Destination : O2Switch, par SFTP. Preparation de la cle et de l'empreinte du
# serveur : voir DEPLOIEMENT-VPS.md §11.
BACKUP_ENABLED=true
# Heure de declenchement (0-23), heure du VPS.
BACKUP_HOUR=3
BACKUP_SFTP_HOST=sauterelle.o2switch.net
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=
# Chemin RELATIF au dossier d'accueil du compte O2Switch. Les niveaux
# manquants sont crees.
BACKUP_SFTP_DIR=sauvegardes/kouttab-stock
# Retention. Le local sert au depannage rapide, le distant est la vraie
# sauvegarde.
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30

# ==============================================================
# HelloAsso integration (Buvette sync)
# Get credentials from your HelloAsso admin: https://admin.helloasso.com
# DO NOT commit real secrets — keep them in .env (gitignored)
# ==============================================================
HELLOASSO_API_BASE=https://api.helloasso.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=eclat-education-culture-langues-apprentissage-transmission
HELLOASSO_BUVETTE_FORM_SLUG=buvette
# Secret partage ajoute a l'URL de webhook enregistree chez HelloAsso.
# HelloAsso ne signe pas ses notifications : sans ce secret, l'endpoint est
# ouvert et n'importe qui peut forger des ventes et decrementer le stock.
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Apres l'avoir defini, relancer POST /api/v1/buvette/webhook/configure.
HELLOASSO_WEBHOOK_SECRET=
