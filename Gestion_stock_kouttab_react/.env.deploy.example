# ---------------------------------------------------------------------------
# Modèle du .env à créer SUR LE VPS, dans le même dossier que compose.yml.
#
# Ce fichier-ci est un exemple versionné : il ne doit contenir aucune valeur
# réelle. Le vrai .env reste sur le VPS, en 600, et n'est jamais commité ni
# copié dans une image.
#
# RÈGLES DE FORMAT — Docker Compose passe les valeurs telles quelles :
#   - pas de guillemets autour des valeurs ;
#   - pas d'espace autour du `=` ;
#   - PAS de commentaire en fin de ligne. `DB_PORT=3306 # port` donne
#     littéralement la valeur "3306 # port", et l'erreur qui en découle ne
#     ressemble en rien à sa cause.
#   - mot de passe contenant #, $ ou une espace : quote simple, 'a#b$c'.
# ---------------------------------------------------------------------------

# --- Déploiement -----------------------------------------------------------
GHCR_OWNER=ton-compte-github
IMAGE_TAG=latest
SITE_DOMAIN=stock.lekouttab.fr
ACME_EMAIL=admin@lekouttab.fr
OUTBOX_INTERVAL_SECONDS=600

# --- Application -----------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# --- Base MySQL O2Switch ---------------------------------------------------
# Connexion directe via « MySQL distant » de cPanel. L'IP du VPS doit y être
# autorisée au préalable, sinon le serveur refuse avant même l'authentification.
#
# DB_HOST : le nom du CLUSTER relevé dans cPanel (ex. sauterelle.o2switch.net),
#           surtout pas localhost — la base n'est plus sur la même machine.
# DB_USER et DB_NAME : cPanel ajoute systématiquement un préfixe de compte.
#           Copier-coller depuis la liste cPanel ; un nom retapé de mémoire
#           sans son préfixe est la panne la plus fréquente.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Variante tunnel SSH (optionnelle) -------------------------------------
# Le protocole MySQL circule en clair : identifiants, emails et RIB compris.
# Si le serveur O2Switch n'accepte pas TLS (cf. DEPLOIEMENT-VPS.md §5), activer
# le tunnel — il chiffre la liaison — puis remplacer ci-dessus par :
#   DB_HOST=db-tunnel
#   DB_PORT=3306
# et démarrer avec : docker compose --profile tunnel up -d
O2SWITCH_SSH_HOST=
O2SWITCH_SSH_USER=
O2SWITCH_SSH_PORT=22
O2SWITCH_DB_HOST=127.0.0.1

# Pool volontairement étroit : la base est distante et un mutualisé plafonne
# max_user_connections. `recycle` doit rester SOUS le wait_timeout du serveur
# (souvent 300 s), sinon on réutilise des connexions déjà fermées d'en face.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE=280

# --- JWT -------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# L'application REFUSE de démarrer en production avec la valeur par défaut.
# Chiffrement du RIB au repos. SON ABSENCE EMPECHE LE DEMARRAGE en
# production, et la PERDRE rend tous les RIB definitivement illisibles.
# Generer : python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
RIB_ENCRYPTION_KEY=

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- SMTP O2Switch ---------------------------------------------------------
# Coupe-circuit d'envoi. `false` = les courriels sont journalisés (destinataires
# compris) sans partir. À laisser sur `true` en production.
EMAIL_ENABLED=true
SMTP_HOST=mail.lekouttab.fr
SMTP_PORT=465
SMTP_USER=no-reply@lekouttab.fr
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_FROM=no-reply@lekouttab.fr
# Destinataire des pièces comptables (factures, tickets de caisse).
# OBLIGATOIRE : laissé vide, chaque dépôt s'empile en file d'attente sans jamais
# partir — c'est arrivé en développement, cinq notes de frais bloquées sans que
# personne ne le voie. La file les enverra dès que l'adresse sera renseignée.
COMPTA_EMAIL=comptabilite@lekouttab.fr

# --- URLs ------------------------------------------------------------------
# CORS_ORIGINS n'accepte que du https en production (garde-fou applicatif).
FRONTEND_URL=https://stock.lekouttab.fr
BACKEND_URL=https://stock.lekouttab.fr/api
CORS_ORIGINS=https://stock.lekouttab.fr

# --- Fichiers --------------------------------------------------------------
# Chemins INTERNES au conteneur : ils correspondent aux volumes de compose.yml.
UPLOAD_DIR=/app/uploads
OUTBOX_DIR=/app/outbox
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=50

# --- HelloAsso -------------------------------------------------------------
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=eclat-education-culture-langues-apprentissage-transmission
HELLOASSO_BUVETTE_FORM_SLUG=buvette
HELLOASSO_WEBHOOK_SECRET=
