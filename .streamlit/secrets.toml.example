# .streamlit/secrets.toml.example
# Copiez ce fichier vers secrets.toml et configurez-le avec vos vraies valeurs POUR LE DÉVELOPPEMENT LOCAL
# EN PRODUCTION (O2Switch), utilisez les variables d'environnement dans .env

[email_credentials]
sender_email = "dev-test@lekouttab.fr"
sender_password = "dev_password"
smtp_server = "localhost"
smtp_port = 587
use_tls = false

# Note : En production sur O2Switch, ces valeurs sont ignorées
# Le système utilise les variables d'environnement :
# EMAIL_SENDER=no-reply@lekouttab.fr
# EMAIL_PASSWORD=votre_mot_de_passe_email
# EMAIL_SMTP=mail.lekouttab.fr
# EMAIL_PORT=465
