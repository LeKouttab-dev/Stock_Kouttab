# Configuration pour l'environnement de DÉVELOPPEMENT
# Copiez ce fichier en .env pour le développement local

# Type d'environnement
ENVIRONMENT=development

# Base de données locale
DATABASE_PATH=data/stock_kouttab.db

# URL locale pour développement
DOMAIN_URL=http://localhost:8501

# Mode debug activé
DEBUG_MODE=true

# Niveau de log détaillé
LOG_LEVEL=DEBUG

# Configuration email (simulation pour développement)
EMAIL_SMTP=mail.lekouttab.fr
EMAIL_PORT=465
EMAIL_SENDER=no-reply@lekouttab.fr
EMAIL_PASSWORD=***REMOVED***


# Clé secrète de développement (pas sécurisée!)
SECRET_KEY=dev_key_not_secure_change_in_production

# Configuration Streamlit pour développement
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=false
